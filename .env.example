# Copy to .env for local use. On Render, set these in the dashboard instead.
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/eradb?retryWrites=true&w=majority
SPRING_DATA_MONGODB_DATABASE=eradb
# generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000
# comma-separated origins, or * for all
CORS_ALLOWED_ORIGINS=//demo
SPRINGDOC_ENABLED=true
